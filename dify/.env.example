# 占位值示例：复制成你自己的配置时不要把真实凭据写进仓库

# PowerContext 服务地址（Dify 应用的环境变量 POWERCONTEXT_BASE_URL 填这个值）
# 本地：http://127.0.0.1:8000
# Dify Cloud：你的公网隧道地址，例如 https://replace-me.trycloudflare.com
# 注意：结尾不要带斜杠
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000

# PowerContext 的数据目录（playbook 脚本 reset.sh / 启动命令使用）
# 推荐独立目录，避免和本机其他 PowerContext 数据混在一起
POWERCONTEXT_HOME=$HOME/memory-forgery/home

# PowerContext 端口（仅本地）
POWERCONTEXT_PORT=8000

# 模型：在 Dify 界面里配置，不放在这里
# 作者实测：deepseek-v4-flush / deepseek-chat（任意 OpenAI 兼容对话模型均可）
# MODEL_NAME=replace-with-your-chat-model

{
  "name": "stepfun-seekdb-kb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-local embedding with seekdb hybrid retrieval",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "db:start": "bash scripts/start-seekdb.sh",
    "test": "vitest run",
    "test:integration": "SEEKDB_TEST=1 vitest run tests/db.integration.test.ts",
    "test:e2e": "npm run build && playwright test",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}

# Copy to qoder/.env and fill in real values. qoder/.env is git-ignored.
# scripts/run_scenario.sh and scripts/start_powercontext.sh load this file
# automatically when it exists.

# Required for LLM synthesis, query embedding and PowerContext hybrid memory.
MINIMAX_API_KEY=replace-me
MINIMAX_BASE_URL=https://replace-me.example/v1
MINIMAX_MODEL=replace-me

# Optional: override the embedding model. Defaults to MiniMax embo-01 (1536).
# PAPERDESK_EMBEDDING_MODEL=embo-01
# PAPERDESK_EMBEDDING_DIM=1536

# Optional: override the chat model used for synthesis.
# PAPERDESK_LLM_MODEL=replace-me
# PAPERDESK_LLM_MODE=auto

# Optional: move runtime data (seekdb files, PowerContext home, web logs).
# PAPERDESK_DATA_DIR=./.runtime
# PAPERDESK_POWERCONTEXT_URL=http://127.0.0.1:8011
# PAPERDESK_POWERCONTEXT_PORT=8011
# PAPERDESK_WEB_PORT=8080

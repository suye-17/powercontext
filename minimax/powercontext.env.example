# Copy to .runtime/powercontext.env and replace /absolute/path/to/minimax with the real path.
# This file contains no credentials.
POWERCONTEXT_HOME=/absolute/path/to/minimax/.runtime/powercontext-home
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8010
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/minimax/.runtime/powercontext.db
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO
POWERCONTEXT_SERVER_LOGGING_ACCESS=true
POWERCONTEXT_SERVER_METRICS_ENABLED=false

      "kind": "code",
      "path": "tasklite/service.py",
      "start_line": 6,
      "end_line": 18,
      "text": "def list_tasks(\n    tasks: Iterable[Task],\n    *,\n    include_archived: bool = False,\n    min_priority: int | None = None,\n) -> list[Task]:\n    visible = [\n        task\n        for task in tasks\n        if (include_archived or not task.archived)\n        and (min_priority is None or task.priority >= min_priority)\n    ]\n    return sorted(visible, key=lambda task: (-task.priority, task.id))",
      "score": 10.0,
      "symbol": "list_tasks"
    },
    {
      "kind": "code",
      "path": "tasklite/service.py",
      "start_line": 21,
      "end_line": 26,
      "text": "def add_task(tasks: list[Task], title: str, priority: int) -> Task:\n    if type(priority) is not int or not 0 <= priority <= 5:\n        raise ValueError(\"priority must be an integer between 0 and 5\")\n    task = Task(id=str(len(tasks) + 1), title=title, priority=priority)\n    tasks.append(task)\n    return task",
      "score": 10.0,
      "symbol": "add_task"
    },
    {
      "kind": "code",
      "path": "tasklite/cli.py",
      "start_line": 19,
      "end_line": 48,
      "text": "def main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(prog=\"tasklite\")\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    list_parser = subparsers.add_parser(\"list\")\n    list_parser.add_argument(\"--include-archived\", action=\"store_true\")\n    list_parser.add_argument(\"--min-priority\", type=int)\n    list_parser.add_argument(\"--data\", default=\"fixtures/tasks.json\")\n\n    add_parser = subparsers.add_parser(\"add\")\n    add_parser.add_argument(\"--title\", required=True)\n    add_parser.add_argument(\"--priority\", type=int, required=True)\n    add_parser.add_argument(\"--data\", default=\"fixtures/tasks.json\")\n\n    args = parser.parse_args(argv)\n    tasks = _load(args.data)\n\n    if args.command == \"list\":\n        result = list_tasks(\n            tasks,\n            include_archived=args.include_archived,\n            min_priority=args.min_priority,\n        )\n        print(json.dumps([task.__dict__ for task in result], ensure_ascii=False))\n        return 0\n\n    task = add_task(tasks, args.title, args.priority)\n    _save(args.data, tasks)\n    print(json.dumps(task.__dict__, ensure_ascii=False))\n    return 0",
      "score": 0.6239,
      "symbol": "main"
    }
